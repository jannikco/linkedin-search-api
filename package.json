{
  "name": "linkedin-search-api",
  "version": "0.2.1",
  "description": "Find relevant LinkedIn people and posts through LeadAdapter. API examples, coding-agent skills and a reviewed research-to-CRM workflow.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test && node --test demo/demo.test.mjs",
    "start": "node example.mjs",
    "demo": "node demo/run.mjs",
    "preflight": "node demo/run.mjs --preflight",
    "verify:read": "node demo/run.mjs --live-read"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./workflows": {
      "types": "./lib/workflows.d.ts",
      "import": "./lib/workflows.mjs"
    }
  },
  "types": "./lib/index.d.ts",
  "bin": {
    "leadadapter": "./lib/cli.mjs"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "capabilities.json",
    "docs",
    "examples",
    "demo"
  ]
}
